{
  "name": "react-template",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "cli:build": "bun run --cwd packages/cli build",
    "cli:dev": "bun run --cwd packages/cli dev",
    "cli:link": "bun run --cwd packages/cli build && cd packages/cli && bun link",
    "cli:test": "LOCAL_TEMPLATE=1 bun packages/cli/bin/index.js",
    "release:cli": "cd packages/cli && release-it",
    "release:template": "cd packages/template && release-it",
    "template:dev": "bun run --cwd packages/template dev",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "husky": "^9.1.7",
    "release-it": "^20.0.1"
  }
}
