{
  "name": "react-template",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "cli:build": "bun run --cwd packages/cli build",
    "cli:dev": "bun run --cwd packages/cli dev",
    "cli:link": "bun run --cwd packages/cli build && cd packages/cli && bun link",
    "cli:test": "bun packages/cli/bin/index.js",
    "template:dev": "bun run --cwd packages/template dev",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "husky": "^9.1.7"
  }
}
